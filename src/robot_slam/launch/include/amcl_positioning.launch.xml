<launch>
  <!-- IMU 数据处理 -->
  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter">
    <param name="use_mag" value="false"/>
    <param name="fixed_frame" value="base_link"/>
    <remap from="imu/data_raw" to="/imu"/> <!-- 根据实际话题名修改 -->
  </node>

  <!-- 激光扫描匹配生成伪里程计 -->
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" name="scan_matcher">
    <param name="use_odom" value="false"/>
    <param name="publish_tf" value="true"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="max_iterations" value="50"/> <!-- 提高匹配精度 -->
    <remap from="scan" to="scan_filtered"/>
  </node>

  <!-- EKF 传感器融合 -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se" clear_params="true">
    <rosparam command="load" file="$(find your_pkg)/config/ekf_params.yaml"/>
  </node>

  <!-- AMCL 定位 -->
  <node pkg="amcl" type="amcl" name="amcl">
    <!-- 禁用里程计依赖 -->
    <param name="odom_model_type" value="omni"/>
    <param name="odom_alpha1" value="100.0"/>
    <param name="odom_alpha2" value="100.0"/>
    <param name="odom_alpha3" value="100.0"/>
    <param name="odom_alpha4" value="100.0"/>
    
    <!-- 强化激光参数 -->
    <param name="laser_max_beams" value="360"/>
    <param name="min_particles" value="1000"/>
    <param name="max_particles" value="5000"/>
    <remap from="scan" to="scan_filtered"/>
  </node>

  <!-- TF 静态变换 -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_imu"
        args="0 0 0.1 0 0 0 base_link imu_link 50"/>
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0.2 0 0.15 0 0 0 base_link laser_link 50"/>
</launch>