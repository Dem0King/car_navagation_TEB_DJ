<launch>
  <arg name="model" default=""/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find robot_slam)/params/carto/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find robot_slam)/params/carto/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <!-- ⚠️ 这两行必须显式写 ns: 对应的 yaml 是"扁平"参数表(没有顶层 local_costmap:/global_costmap: 键)。
         不写 ns 也能靠顶层键生效, 但一旦 yaml 的顶层键写错/改动, 参数会整体落到别的命名空间,
         costmap 会静默退回默认值(非滚动、map 系、10m×10m) —— 这就是之前"不避障 + 传感器原点出界刷屏"的原因。 -->
    <rosparam file="$(find robot_slam)/params/carto/local_costmap_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find robot_slam)/params/carto/global_costmap_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find robot_slam)/params/carto/teb_local_planner_params.yaml" command="load" />
    <rosparam file="$(find robot_slam)/params/carto/move_base.yaml" command="load" />
    <rosparam file="$(find robot_slam)/params/carto/global_planner_params.yaml" command="load" />
    <remap from="/cmd_vel" to="/cmd_vel" />
    <remap from="/odom" to="/odom" />
  </node>
</launch>
